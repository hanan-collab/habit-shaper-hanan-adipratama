# Local scaffold credentials only. Replace for shared deployments.
# Use URL-safe values for the database user/password (DATABASE_URL is assembled by Compose).
APP_PORT=3000
MYSQL_PORT=3306
MYSQL_DATABASE=habit_shaper
MYSQL_USER=habit_shaper
MYSQL_PASSWORD=scaffold_password
MYSQL_ROOT_PASSWORD=scaffold_root_password
BCRYPT_ROUNDS=12
SESSION_TTL_DAYS=7
# Set true only when the app is served over HTTPS.
COOKIE_SECURE=false
